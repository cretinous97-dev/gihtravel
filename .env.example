# =============================================================================
# GIH Tour and Travel — environment variables
# Copy this file to `.env.local` (for `npm run dev`) and fill in the values.
# Every variable is also documented, step by step, in README.md under
# "## MANUAL SETUP — YOUR PART (DO THIS AFTER THE BUILD)".
# =============================================================================

# -----------------------------------------------------------------------------
# Sanity CMS (https://sanity.io — free tier is enough)
# After you create your Sanity project, copy these three values from
# https://sanity.io/manage  →  your project  →  API  →  Project details.
# -----------------------------------------------------------------------------

# Your Sanity project ID (looks like: abc12345)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id

# The dataset name. The seed script writes to this dataset. Use "production".
NEXT_PUBLIC_SANITY_DATASET=production

# API version to pin (date string). Leave as-is unless you know otherwise.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# A Sanity **write** token (Editor access). Needed by the seed script and by
# the inquiry form to save new inquiry documents. NEVER commit the real value.
# Create at: https://www.sanity.io/manage → API → Tokens → "Add API token"
SANITY_API_WRITE_TOKEN=your-sanity-write-token-here

# Optional: shared secret for the on-demand revalidation webhook
# (Sanity webhooks → POST to /api/revalidate with header "x-webhook-secret").
SANITY_REVALIDATE_SECRET=choose-a-long-random-string

# -----------------------------------------------------------------------------
# Gmail SMTP (inquiry notification + traveller auto-reply)
# Gmail requires a 16-character **App Password** (not your normal password).
# Create one at https://myaccount.google.com/apppasswords after enabling
# 2-Step Verification on the gihbucketlist@gmail.com account.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gihbucketlist@gmail.com
SMTP_PASS=your-16-char-app-password-here
SMTP_FROM="GIH Tour and Travel <gihbucketlist@gmail.com>"

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public URL of the deployed site (no trailing slash). Used for sitemap,
# canonical metadata, and JSON-LD structured data.
NEXT_PUBLIC_SITE_URL=https://gihtourtravel.vercel.app
